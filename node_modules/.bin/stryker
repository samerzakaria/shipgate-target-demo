#!/usr/bin/env python3
import json
import pathlib
import subprocess
import sys

if "--version" in sys.argv:
    print("shipgate-reference-mutator 1.0.0")
    raise SystemExit(0)

root = pathlib.Path.cwd()
source = root / "service.py"
original = source.read_text()
mutations = [("return a + b", "return a - b"), ("a == 0", "a != 0")]
rows = []
try:
    for old, new in mutations:
        source.write_text(original.replace(old, new, 1))
        result = subprocess.run(
            [sys.executable, "-m", "unittest", "discover", "-s", "tests"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        rows.append({"status": "Killed" if result.returncode else "Survived"})
finally:
    source.write_text(original)

out = root / "reports" / "mutation"
out.mkdir(parents=True, exist_ok=True)
(out / "mutation.json").write_text(json.dumps({
    "files": {"service.py": {"mutants": rows}}
}))
